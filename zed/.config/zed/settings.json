// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "ui_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "base_keymap": "VSCode",
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Mirage"
  },
  "file_types": {
    "Shell Script": ["conf"]
  },
  "languages": {
    "JSONC": {
      "format_on_save": "off"
    }
  },
    "lsp": {
      "lua-language-server": {
        "settings": {
          "Lua": {
            "workspace": {
              "library": [
                "/usr/share/hypr/stubs"
              ],
              // This forces the server to only use the library if the path matches
              "userThirdParty": [
                "**/hypr/**"
              ]
            },
            "diagnostics": {
              // We scope the global variable definition inside a standard Lua-LS block
              "globals": ["hl"]
            }
          }
        }
      }
    }
}
